# Copy this file to mobile/.env and fill in the values before running the mobile app.
# mobile/.env is gitignored — never commit real keys.
# The .env file is bundled as a Flutter asset (see pubspec.yaml) and read via flutter_dotenv.

# Supabase project credentials (Supabase Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Maps Geocoding API key (reverse geocoding for assistance features)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Optional: Huawei AppGallery Connect API key (Mandarin speech services)
# HMS_API_KEY=your-hms-api-key