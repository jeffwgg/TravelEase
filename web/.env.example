# Copy this file to web/.env and fill in the values before running the web app.
# web/.env is gitignored — never commit real keys.

# Supabase project credentials (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Maps Geocoding API key (used for address search on staff pages)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key